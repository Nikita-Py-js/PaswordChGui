<Window x:Class="PaswordChGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PaswordCh — смена паролей"
        Height="720" Width="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg}"
        FontFamily="Segoe UI">

	<!-- Ресурсы объявлены В НАЧАЛЕ, до использования -->
	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- ============================================================
             ШАПКА
             ============================================================ -->
		<Border Grid.Row="0" Background="{StaticResource Brush.Black}" Padding="24,18">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" VerticalAlignment="Center">
					<TextBlock Text="EFSOL"
                               FontSize="22" FontWeight="Black" Foreground="White" />
					<TextBlock Text="Смена паролей пользователей"
                               FontSize="12" Foreground="#BDBDBD" Margin="0,2,0,0" />
				</StackPanel>

				<StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
					<TextBlock Text="{Binding CurrentUser}"
                               FontSize="13" Foreground="#FFC400" FontWeight="SemiBold"
                               HorizontalAlignment="Right" />
					<TextBlock Text="{Binding RoleText}"
                               FontSize="11" Foreground="#9CA3AF"
                               HorizontalAlignment="Right" Margin="0,2,0,0" />
				</StackPanel>
			</Grid>
		</Border>

		<!-- ============================================================
             ВКЛАДКИ
             ============================================================ -->
		<TabControl Grid.Row="1" Margin="24,20,24,12"
                    Style="{StaticResource EfsolTabControl}">

			<!-- === ВКЛАДКА: СТАТУС === -->
			<TabItem Header="Статус" Style="{StaticResource EfsolTabItem}">
				<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
					<Border Style="{StaticResource Card}" Margin="0,12,0,0">
						<StackPanel>

							<!-- Связь со службой -->
							<TextBlock Text="Связь со службой"
                                       FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />

							<Grid Margin="0,0,0,8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="180" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="Состояние:" Foreground="{StaticResource Brush.Muted}" />
								<TextBlock Grid.Column="1" Text="{Binding PingStatus}" FontWeight="SemiBold" />
							</Grid>

							<Grid Margin="0,0,0,8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="180" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="Следующая смена:" Foreground="{StaticResource Brush.Muted}" />
								<TextBlock Grid.Column="1" Text="{Binding NextRunText}" FontWeight="SemiBold" />
							</Grid>

							<Grid Margin="0,0,0,20">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="180" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="Интервал (дней):" Foreground="{StaticResource Brush.Muted}" />
								<TextBlock Grid.Column="1" Text="{Binding IntervalDaysText}" FontWeight="SemiBold" />
							</Grid>

							<!-- Кнопки связи -->
							<StackPanel Orientation="Horizontal">
								<Button Content="Проверить связь"
                                        Command="{Binding PingCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,10,0" />
								<Button Content="Обновить"
                                        Command="{Binding RefreshCommand}"
                                        Style="{StaticResource PrimaryButton}" />
							</StackPanel>

							<!-- ============================================================
                                 ОПАСНАЯ ЗОНА
                                 ============================================================ -->
							<Border Margin="0,24,0,0"
                                    Background="#FFF5F5"
                                    BorderBrush="#FCA5A5"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">
								<StackPanel>
									<TextBlock Text="Опасное действие"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="#991B1B" />
									<TextBlock Margin="0,8,0,0"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="#7F1D1D"
                                               LineHeight="19">
										Смена паролей для <Run FontWeight="Bold">всех</Run> пользователей из emails.csv.
										Каждый пользователь получит письмо с новым паролем или ссылкой.
										Защищённые логины не затрагиваются.
									</TextBlock>
									<Button Content="Сменить пароли всем"
                                            Command="{Binding RunAllCommand}"
                                            Style="{StaticResource DangerButton}"
                                            HorizontalAlignment="Left"
                                            Margin="0,14,0,0" />
								</StackPanel>
							</Border>

							<!-- ============================================================
                                 РЕЗУЛЬТАТЫ МАССОВОЙ СМЕНЫ
                                 ============================================================ -->
							<Border Margin="0,20,0,0"
                                    Background="#FFFFFF"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Visibility="{Binding HasRunResults, Converter={StaticResource BoolToVisibility}}">
								<StackPanel>
									<TextBlock Text="Результаты массовой смены"
                                               FontSize="14" FontWeight="SemiBold"
                                               Margin="0,0,0,4" />
									<TextBlock Text="{Binding RunSummary}"
                                               FontSize="13" Foreground="{StaticResource Brush.Muted}"
                                               Margin="0,0,0,12" />

									<ListView ItemsSource="{Binding RunResults}"
                                              MaxHeight="240"
                                              BorderThickness="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
										<ListView.ItemContainerStyle>
											<Style TargetType="ListViewItem">
												<Setter Property="HorizontalContentAlignment" Value="Stretch" />
												<Setter Property="Padding" Value="0,4" />
											</Style>
										</ListView.ItemContainerStyle>
										<ListView.ItemTemplate>
											<DataTemplate>
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="200" />
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>

													<TextBlock Grid.Column="0"
                                                               Text="{Binding Username}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />

													<TextBlock Grid.Column="1"
                                                               Text="{Binding Email}"
                                                               Foreground="{StaticResource Brush.Muted}"
                                                               VerticalAlignment="Center" />

													<TextBlock Grid.Column="2"
                                                               Text="{Binding StatusText}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding StatusColor}" />
												</Grid>
											</DataTemplate>
										</ListView.ItemTemplate>
									</ListView>

									<TextBlock Margin="0,10,0,0"
                                               FontSize="11" Foreground="{StaticResource Brush.Muted}"
                                               Text="Пароли сохранены в ZIP-архив в каталоге Archive службы." />
								</StackPanel>
							</Border>

						</StackPanel>
					</Border>
				</ScrollViewer>
			</TabItem>

			<!-- === ВКЛАДКА: СМЕНИТЬ ПАРОЛЬ === -->
			<TabItem Header="Сменить пароль" Style="{StaticResource EfsolTabItem}">
				<Border Style="{StaticResource Card}" Margin="0,12,0,0">
					<StackPanel>
						<TextBlock Text="Сменить пароль"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />

						<TextBlock Text="Логин (оставьте пустым, чтобы сменить свой):"
                                   Foreground="{StaticResource Brush.Muted}"
                                   FontSize="13" Margin="0,0,0,4" />
						<TextBox Text="{Binding TargetUser, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16" />

						<Button Content="Сменить пароль"
                                Command="{Binding ChangeCommand}"
                                Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Left" />

						<!-- Результат -->
						<Border Margin="0,20,0,0"
                                Background="#FAFAFA" BorderBrush="#E8E8E8" BorderThickness="1"
                                CornerRadius="8" Padding="16"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
							<StackPanel>
								<TextBlock Text="{Binding ResultMessage}"
                                           FontSize="14" TextWrapping="Wrap"
                                           Foreground="{Binding ResultColor}" />
								<TextBlock Text="{Binding ResultPassword}"
                                           FontFamily="Consolas" FontSize="20"
                                           FontWeight="Bold" Margin="0,10,0,0" />
							</StackPanel>
						</Border>
					</StackPanel>
				</Border>
			</TabItem>

			<!-- === ВКЛАДКА: О ПРОГРАММЕ === -->
			<TabItem Header="О программе" Style="{StaticResource EfsolTabItem}">
				<Border Style="{StaticResource Card}" Margin="0,12,0,0">
					<StackPanel>
						<TextBlock Text="PaswordCh GUI" FontSize="18" FontWeight="Bold" />
						<TextBlock Text="Графический клиент службы PaswordChService."
                                   Foreground="{StaticResource Brush.Muted}" Margin="0,6,0,16" />
						<TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20">
							Все операции выполняются через именованный канал и не требуют прав
							администратора. Служба продолжает работать в фоне — GUI только
							отправляет ей запросы.
						</TextBlock>
						<TextBlock Text="Разработано ООО «Реумент»" Foreground="{StaticResource Brush.Muted}"
                                   FontSize="12" Margin="0,20,0,0" />
					</StackPanel>
				</Border>
			</TabItem>

		</TabControl>

		<!-- ============================================================
             ПОДВАЛ / СТАТУС
             ============================================================ -->
		<Border Grid.Row="2"
                Background="{StaticResource Brush.White}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="24,10">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<Ellipse Grid.Column="0"
                         Width="10" Height="10"
                         VerticalAlignment="Center"
                         Fill="{Binding StatusDotBrush}" />

				<TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource Brush.Dark}"
                           Text="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis" />

				<TextBlock Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource Brush.Muted}"
                           Text="PaswordCh GUI v1.0" />
			</Grid>
		</Border>
	</Grid>
</Window>